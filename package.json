{
  "name": "workspaces",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "tools/*",
    "packages/management-sdk/examples/*",
    "packages/react-sdk/dev/*",
    "packages/react-native-sdk/dev/*",
    "packages/openfeature-browser-provider/example",
    "packages/node-sdk/examples/express"
  ],
  "scripts": {
    "changeset": "changeset",
    "dev": "lerna run dev --parallel",
    "build": "lerna run build --stream",
    "test:ci": "yarn test:tooling && lerna run test:ci --stream",
    "test:tooling": "node --test scripts/dependency-compat.test.cjs",
    "audit:ci": "yarn npm audit --all --recursive --no-deprecations",
    "test": "lerna run test --stream",
    "format": "yarn fmt:fix && yarn lint:fix",
    "lint": "yarn oxlint .",
    "lint:ci": "yarn oxlint .",
    "version-packages": "changeset version && YARN_ENABLE_IMMUTABLE_INSTALLS=false yarn install",
    "release-packages": "yarn build && yarn release",
    "release": "changeset publish",
    "docs": "./docs.sh",
    "lint:fix": "yarn oxlint --fix .",
    "fmt": "yarn oxfmt --check .",
    "fmt:fix": "yarn oxfmt --write .",
    "postinstall": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "husky": "^9.1.7",
    "lerna": "^10.1.1",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.42.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typedoc": "patch:typedoc@npm%3A0.27.6#~/.yarn/patches/typedoc-npm-0.27.6-baed42df20.patch",
    "typedoc-plugin-frontmatter": "^1.1.2",
    "typedoc-plugin-markdown": "^4.4.2",
    "typedoc-plugin-mdn-links": "^4.0.7",
    "typescript": "^5.7.3"
  },
  "resolutions": {
    "basic-ftp@npm:^5.3.1": "npm:6.2.6",
    "deepmerge": "workspace:tools/deepmerge",
    "glob@npm:13.0.6": "npm:14.0.4",
    "glob@npm:^10.3.10": "npm:14.0.4",
    "glob@npm:^10.4.1": "npm:14.0.4",
    "glob@npm:^13.0.0": "npm:14.0.4",
    "glob@npm:^13.0.6": "npm:14.0.4",
    "metro-babel-transformer@npm:0.83.3": "npm:0.83.8",
    "metro-cache-key@npm:0.83.3": "npm:0.83.8",
    "metro-cache@npm:0.83.3": "npm:0.83.8",
    "metro-config@npm:0.83.3": "npm:0.83.8",
    "metro-core@npm:0.83.3": "npm:0.83.8",
    "metro-file-map@npm:0.83.3": "npm:0.83.8",
    "metro-minify-terser@npm:0.83.3": "npm:0.83.8",
    "metro-resolver@npm:0.83.3": "npm:0.83.8",
    "metro-runtime@npm:0.83.3": "npm:0.83.8",
    "metro-source-map@npm:0.83.3": "npm:0.83.8",
    "metro-symbolicate@npm:0.83.3": "npm:0.83.8",
    "metro-transform-plugins@npm:0.83.3": "npm:0.83.8",
    "metro-transform-worker@npm:0.83.3": "npm:0.83.8",
    "metro@npm:0.83.3": "npm:0.83.8",
    "minimatch@npm:10.2.3": "npm:11.0.5",
    "minimatch@npm:10.2.5": "npm:11.0.5",
    "minimatch@npm:10.2.6": "npm:11.0.5",
    "minimatch@npm:^10.0.3": "npm:11.0.5",
    "minimatch@npm:^10.2.2": "npm:11.0.5",
    "minimatch@npm:^10.2.6": "npm:11.0.5",
    "minimatch@npm:^9.0.0": "npm:11.0.5",
    "minimatch@npm:^9.0.3": "npm:11.0.5",
    "minimatch@npm:^9.0.4": "npm:11.0.5",
    "minimatch@npm:^9.0.5": "npm:11.0.5",
    "minimatch@npm:~10.2.4": "npm:11.0.5",
    "postcss@npm:8.4.31": "npm:8.5.32",
    "postcss@npm:~8.4.32": "npm:8.5.32",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tinypool@npm:2.0.0": "npm:2.2.0",
    "undici@npm:7.29.0": "npm:7.30.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,vue}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "yarn@4.10.3"
}
