{
  "name": "@reflag/react-native-sdk",
  "version": "2.0.0-next.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/reflagcom/javascript.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "react-native": "./dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "react-native": "./dist/src/index.js",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "yarn test:types && vitest run",
    "test:types": "tsc --project tsconfig.type-tests.json && tsc --project tsconfig.type-tests-registered.json && tsc --project tsconfig.test.json && tsc --project dev/bare-rn/tsconfig.json --noEmit && tsc --project dev/expo/tsconfig.json --noEmit",
    "test:ci": "yarn test --reporter=default --reporter=junit --outputFile=junit.xml",
    "lint": "oxlint .",
    "lint:ci": "oxlint .",
    "format": "yarn fmt:fix && yarn lint:fix",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt --write ."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@reflag/react-sdk": "^2.0.0-next.2",
    "react-native-sse": "^1.2.1"
  },
  "devDependencies": {
    "@reflag/node-sdk": "2.0.0-next.3",
    "@reflag/tsconfig": "^0.0.2",
    "@types/node": "^22.12.0",
    "@types/react": "^19.0.12",
    "@types/react-test-renderer": "^19.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.7.3",
    "vitest": "~4.1.12"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": "*"
  }
}
